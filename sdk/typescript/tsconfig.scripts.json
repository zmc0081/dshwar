// 构建脚本的类型检查项目。与 `tsconfig.test.json` 同构,理由见
// `packages/api-contract/tsconfig.scripts.json` 的说明。
//
// 这里的两个脚本(`generate.ts` / `render.ts`)是 SDK 类型生成链路,
// 它们出错的后果是「生成的 SDK 类型与契约不符」—— 而那种不符不会在
// SDK 自己的测试里现形,只会在客户手里现形。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "rootDir": ".",
    "tsBuildInfoFile": "./dist/.tsbuildinfo.scripts"
  },
  "include": ["scripts/**/*.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [
    {
      "path": "./tsconfig.json"
    }
  ]
}
