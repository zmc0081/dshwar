{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo"
  },
  // 只引 SDK。示例被类型检查这件事本身就是验收的一部分:
  // 如果这里需要再引一个包才能编译,那「仅凭 SDK」就是假的。
  "references": [{ "path": "../../sdk/typescript" }],
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
