{
  "name": "dshwar",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "DeepSeek Harness 之上的 ToB 产品基座。上游做能力,DSHWAR 做归属、隔离、配额、计费、审计。",
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run",
    "test:contract": "vitest run --dir adapters",
    "test:linux": "docker run --rm -v \"%cd%:/src:ro\" -w / node:24 bash /src/scripts/test-linux.sh",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version.mjs",
    "check:guards": "node scripts/check-guards.mjs",
    "verify:guards": "node scripts/verify-guards.mjs",
    "check:all": "pnpm check:version && pnpm check:guards && pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "js-yaml": "^5.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
