{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    // ⚠️ 需要 DOM 的 WebCrypto 类型。**这不等于允许用浏览器专有 API** ——
    // 本包刻意只用 `crypto.subtle`,那是 Node 18+ 与浏览器都有的标准接口。
    "lib": ["es2023", "dom"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
