{
  "name": "@dshwar/design-system",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles/*": "./src/styles/*",
    "./screens/*": {
      "types": "./dist/screens/*.d.ts",
      "default": "./dist/screens/*.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "serve": "node scripts/serve.mjs",
    "dev": "vite"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "8.2.1"
  }
}
