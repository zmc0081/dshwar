// 测试文件的类型检查项目 —— 与 packages/metering 同款,理由见那个文件的注释:
// 产品项目是 composite + rootDir: "./src",把 test/ 并进去会把 rootDir 抬到包根,
// dist/ 里凭空多出两层。所以另起一个 noEmit 项目,references 指向产品项目,
// 测试里的 `../src/xxx.ts` 由 tsc --build 重定向到已构建的 .d.ts。
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": false,
    "rootDir": ".",
    "tsBuildInfoFile": "./dist/.tsbuildinfo.test"
  },
  // ⚠️ `vite.config.ts` 也在这里,不在产品项目里 —— 产品项目是 rootDir: "./src",
  // 把包根的文件并进去会把 rootDir 抬起来、dist/ 凭空多两层。
  //
  // 不并进任何项目的后果是**它整个不被类型检查**:实测在里面写
  // `const x: number = '字符串'`,`pnpm typecheck` 照样绿。
  // 一个配置文件写错类型不会立刻炸,只会在 dev server 起不来时才发现。
  "include": ["test/**/*.ts", "test/**/*.tsx", "vite.config.ts"],
  "exclude": ["dist", "node_modules"],
  "references": [{ "path": "./tsconfig.json" }]
}
