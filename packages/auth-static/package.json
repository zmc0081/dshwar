{
  "name": "@dshwar/auth-static",
  "version": "0.6.5",
  "description": "配置声明的 token → principal 映射。零外部依赖跑通开发环境,并作为全部契约测试的 fixture。禁止部署。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dshwar/auth": "workspace:*",
    "@dshwar/principal": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
