{
  "name": "@dshwar/attachment-tenant",
  "version": "0.6.0",
  "description": "附件的租户隔离存储。路径与工作区同款钉死,复用 fs-tenant 的编码规则。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dshwar/fs-tenant": "workspace:*",
    "@dshwar/principal": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
