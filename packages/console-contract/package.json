{
  "name": "@dshwar/console-contract",
  "version": "0.8.0",
  "description": "控制平面契约:租户 / 成员 / 角色 / 配额 / 用量 / 审计查询的共享类型。与 /v1 运行时契约分开版本化。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@dshwar/audit": "workspace:*",
    "@dshwar/metering": "workspace:*",
    "@dshwar/policy": "workspace:*",
    "@dshwar/subject": "workspace:*"
  }
