{
  "name": "@dshwar/gateway",
  "version": "0.4.6",
  "description": "API 平面服务。Hono,Web 标准,可跑 Node 与边缘。",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json",
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "default": "./dist/runtime.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@dshwar/api-contract": "workspace:*",
    "@dshwar/audit": "workspace:*",
    "@dshwar/auth": "workspace:*",
    "@dshwar/fs-tenant": "workspace:*",
    "@dshwar/metering": "workspace:*",
    "@dshwar/model-router": "workspace:*",
    "@dshwar/policy": "workspace:*",
    "@dshwar/principal": "workspace:*",
