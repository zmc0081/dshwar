    "@dshwar/auth-static": "workspace:*",
    "@dshwar/credentials-multiuser": "workspace:*",
    "@dshwar/example-sdk-session": "workspace:*",
    "@dshwar/scim-server": "workspace:*",
    "@dshwar/storage-scoped": "workspace:*",
    "@dshwar/subject": "workspace:*",
    "@dshwar/tenant-map": "workspace:*",
    "@dshwar/webhooks": "workspace:*",
    "@hono/node-server": "^1.19.7",
    "jose": "^6.2.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dshwar-gateway": "./dist/server.js"
