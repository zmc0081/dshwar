{
  "$schema": "https://json.schemastore.org/tsconfig",
  // 解决方案文件:自身不含源码,只把各 workspace 包串成 project references。
  // 新增包时在此登记一行 —— 忘了登记 CI 就构建不到它,这是刻意的。
  //
  // `include: []` 而非 `files: []`:references 尚为空时(Session 2 才落第一个包),
  // 空的 `files` 会触发 TS18002。
  "include": [],
  "references": [
    { "path": "./packages/api-contract" },
    { "path": "./packages/principal" },
    { "path": "./packages/auth" },
    { "path": "./packages/auth-static" },
    { "path": "./packages/design-system" },
    { "path": "./console-web" },
    { "path": "./workbench-web" },
    { "path": "./packages/console-contract" },
    { "path": "./packages/credentials-multiuser" },
    { "path": "./packages/fs-tenant" },
    { "path": "./packages/storage-scoped" },
    { "path": "./packages/subject" },
    { "path": "./packages/tenant-map" },
    { "path": "./packages/auth-jwt" },
    { "path": "./packages/auth-oidc" },
    { "path": "./packages/scim-server" },
    { "path": "./packages/webhooks" },
    { "path": "./packages/attachment-tenant" },
    { "path": "./packages/audit" },
    { "path": "./packages/llm-local" },
    { "path": "./packages/metering" },
    { "path": "./packages/billing" },
    { "path": "./packages/billing-local" },
    { "path": "./packages/billing-stripe" },
    { "path": "./packages/policy" },
    { "path": "./packages/model-router" },
    { "path": "./packages/supervisor" },
    { "path": "./adapters/dsh-0.1.0" },
    { "path": "./gateway" },
    { "path": "./sdk/typescript" },
    { "path": "./examples/sdk-session" },
    { "path": "./examples/minimal-server" }
  ]
}
