{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DSHWAR",
  "version": "0.9.0",
  "identifier": "com.dshwar.desktop",
  "build": {
    "frontendDist": "../workbench-web/dist",
    "devUrl": "http://localhost:4322"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/dshwar-gateway"],
    "resources": ["sidecar/**/*"],
    "shortDescription": "DSHWAR 工作台",
    "longDescription": "DSHWAR 桌面工作台 —— 本地 sidecar + 系统钥匙串,界面由运行期主题决定。"
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://updates.dshwar.com/{{target}}/{{arch}}/{{current_version}}"],
      "pubkey": "",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
