{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的能力清单 —— 只给它拉起 sidecar 这一件事,别的一概不给。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/dshwar-gateway",
          "sidecar": true,
          "args": [
            { "validator": "^[^\\n\\r]+server\\.js$" },
            "--config",
            { "validator": "^[^\\n\\r]+\\.json$" }
          ]
        }
      ]
    }
  ]
}
